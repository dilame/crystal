%%{init: {'themeVariables': { 'fontSize': '12px'}}}%%
graph TD
    classDef path fill:#eee,stroke:#000,color:#000
    classDef plan fill:#fff,stroke-width:1px,color:#000
    classDef itemplan fill:#fff,stroke-width:2px,color:#000
    classDef unbatchedplan fill:#dff,stroke-width:1px,color:#000
    classDef sideeffectplan fill:#fcc,stroke-width:2px,color:#000
    classDef bucket fill:#f6f6f6,color:#000,stroke-width:2px,text-align:left

    subgraph "Buckets for queries/polymorphic/defaultType"
    Bucket0("Bucket 0 (root)<br /><br />1: <br />ᐳ: 9, 10, 40, 43, 11<br />2: PgSelect[8]<br />3: Connection[12]<br />4: ConnectionItems[14]"):::bucket
    Bucket1("Bucket 1 (nullableBoundary)<br />Deps: 12, 14, 11, 40, 43<br /><br />ROOT Connectionᐸ8ᐳ[12]"):::bucket
    Bucket3("Bucket 3 (listItem)<br />Deps: 11, 40, 43<br /><br />ROOT __Item{3}ᐸ14ᐳ[17]"):::bucket
    Bucket4("Bucket 4 (polymorphic)<br />__typename: Lambda[23]<br />Deps: 23, 11, 19, 40, 43, 18, 22, 36, 38"):::bucket
    Bucket5("Bucket 5 (polymorphicPartition)<br />|PaidEvent<br />Deps: 11, 19, 40, 22, 36, 38<br />ᐳPaidEvent<br /><br />1: PgSelect[25]<br />ᐳ: List[41], Lambda[42]<br />2: PgSelectRows[30]<br />ᐳ: 29, 31, 46"):::bucket
    Bucket6("Bucket 6 (polymorphicPartition)<br />|EventDefault<br />Deps: 43, 19, 18, 22, 36, 38<br />ᐳEventDefault"):::bucket
    end
    Bucket0 --> Bucket1
    Bucket1 --> Bucket3
    Bucket3 --> Bucket4
    Bucket4 --> Bucket5 & Bucket6

